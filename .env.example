# PostgreSQL user for local Compose.
POSTGRES_USER=app
# PostgreSQL password for local Compose; replace outside local development.
POSTGRES_PASSWORD=app_secret
# PostgreSQL database for local Compose.
POSTGRES_DB=app
# Browser API address.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional host port overrides.
BACKEND_PORT=8080
FRONTEND_PORT=3000
